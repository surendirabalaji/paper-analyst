{
  "description": "Curated arXiv corpus for the Agentic AI Paper Analyst. Papers on LLM agents, tool use, multi-agent systems, retrieval-augmented generation, agent memory, and agent evaluation.",
  "curated_on": "2026-10-26",
  "method": "Hand-picked foundational papers (2022-12 to 2024) verified by id against the arXiv API, plus recent papers (2025-01 to 2026-09) chosen from arXiv API title searches on the same topics so that cross-paper comparison questions have answers. Every id was checked against the arXiv API title before inclusion.",
  "selection_criteria": [
    "Topic: LLM agents, tool use, multi-agent systems, RAG, agent memory, or agent evaluation",
    "Mostly cs.CL / cs.AI / cs.LG / cs.MA / cs.IR (a few seminal cs.SE, cs.HC, cs.OS, cs.CR papers are included for coverage)",
    "Full text is indexed only if arXiv serves LaTeXML HTML that parses to at least 3000 words; otherwise metadata only",
    "Topical overlap between papers so comparison questions are answerable"
  ],
