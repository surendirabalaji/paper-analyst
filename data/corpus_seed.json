    "ti:\"model context protocol\"",
    "ti:\"tool use\" AND ti:agents AND cat:cs.CL",
    "ti:\"deep research\" AND ti:agent",
    "ti:agent AND ti:benchmark AND cat:cs.AI"
  ],
