# Agentic AI Paper Analyst: environment configuration.
# Copy to .env and fill in real values. Never commit .env.
# Model IDs below are candidates checked against the OpenRouter public catalog on 2026-10-26.
# They are re-verified against each provider's API in Phase 0 and before submission.

# --- Generation provider 1: OpenAI (direct API) ---
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-6.1-sol

# --- Generation provider 2: Google Gemini, served through OpenRouter ---
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_MODEL=google/gemini-3.8-flash

# --- Embeddings (OpenAI direct; not counted as a generation provider) ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store (Chroma embedded, index baked into the container image) ---
CHROMA_PERSIST_DIR=./data/chroma_index
CHROMA_COLLECTION=arxiv_agents
RAG_TOP_K=6

# --- Structured metadata store (read-only at runtime) ---
SQLITE_PATH=./data/papers.db

# --- Real-time knowledge: Tavily Remote MCP (key is sent as a URL query parameter) ---
TAVILY_API_KEY=tvly-REPLACE_ME

# --- Orchestration bounds ---
MAX_SUPERVISOR_STEPS=6
MAX_TOOL_ROUNDS=4
WORKER_TIMEOUT_S=45
REQUEST_BUDGET_S=120

# --- Cloud Run deployment ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=paper-analyst

# --- State ---
# Stateless, single-turn design: no durable conversation store is used or claimed.
