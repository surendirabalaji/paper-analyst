# Agentic AI Paper Analyst: environment configuration.
# Copy to .env and fill in real values. Never commit .env.
# Model IDs below were verified with real streaming + tool-calling calls on 2026-10-27
# (OpenAI /v1/models; OpenRouter catalog). Re-verify before submission.
# Prices checked 2026-10-27, per 1M tokens input / output:
#   gpt-6.1-sol             $2.00 / $10.00  (developers.openai.com/api/docs/pricing, standard tier)
#   google/gemini-3.8-flash $1.50 / $7.50   (conservative upper bound used for costing: the upstream cost OpenRouter
#                           reports for BYOK calls, which Google bills on your own key. Google lists $0.75 / $3.75
#                           through 2026-12-31 and $1.50 / $7.50 from 2027-01-01 (ai.google.dev/gemini-api/docs/pricing),
#                           and the key's Gemini free tier may cover some calls; OpenRouter's catalog price
#                           $0.825 / $4.125 does not apply to BYOK calls. Check the Google bill.)

# --- Generation provider 1: OpenAI (direct API) ---
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-6.1-sol

# --- Generation provider 2: Google Gemini, served through OpenRouter ---
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_MODEL=google/gemini-3.8-flash

# --- Routing (hybrid cost/capability policy in app/llm/policy.py) ---
# Gemini 3.8 Flash cannot turn reasoning off; low effort keeps reasoning tokens near zero and TTFT ~1.5 s.
GEMINI_REASONING_EFFORT=low
# Empty = model default reasoning for the capability side.
OPENAI_REASONING_EFFORT=
# 1 = on a provider error (after one retry for transient errors), retry the call on the other provider.
LLM_FALLBACK=1
# Evaluation only (not deployed): force every call to one provider, "openai" or "gemini-openrouter".
ROUTER_FORCE_PROVIDER=
LLM_TIMEOUT_S=60

# --- Embeddings (OpenAI direct; not counted as a generation provider) ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store (Chroma embedded, index baked into the container image) ---
CHROMA_PERSIST_DIR=./data/chroma_index
CHROMA_COLLECTION=arxiv_agents
RAG_TOP_K=6

# --- Structured metadata store (read-only at runtime) ---
SQLITE_PATH=./data/papers.db

# --- Real-time knowledge: Tavily Remote MCP (Streamable HTTP; key is sent only as the tavilyApiKey URL query
# parameter of https://mcp.tavily.com/mcp/, never logged). Shared tavily_search tool: Research + Summary. ---
TAVILY_API_KEY=tvly-REPLACE_ME
TAVILY_TIMEOUT_S=15
TAVILY_MAX_RESULTS=4
# Best corpus similarity below this = low corpus support: Research may then search the web (calibrated 2026-10-27).
RAG_MIN_SCORE=0.55

# --- Orchestration bounds ---
MAX_SUPERVISOR_STEPS=6
MAX_TOOL_ROUNDS=4
WORKER_TIMEOUT_S=45
REQUEST_BUDGET_S=120

# --- Cloud Run deployment ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=paper-analyst

# --- State ---
# Stateless, single-turn design: no durable conversation store is used or claimed.
